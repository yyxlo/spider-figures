# 複製成 .env 後修改。.env 不要放進 git。
# 隨機長字串，可用：python3 -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=請改成隨機長字串
POSTGRES_PASSWORD=請改成資料庫密碼
# 允許連入的主機名稱或 IP，逗號分隔；* 代表全部（僅限內網使用）
DJANGO_ALLOWED_HOSTS=*
# 若用 IP 連線出現 CSRF 錯誤，填入完整網址，例如 http://192.168.1.50:8000
DJANGO_CSRF_TRUSTED_ORIGINS=
DJANGO_DEBUG=0
PORT=8000
TZ=Asia/Taipei
